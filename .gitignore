# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# Environment variables (use .env.example as the template)
.env
.env.*
!.env.example

# Capacitor native platforms — generated by the Codemagic build pipeline
# Do not commit these; Codemagic runs `cap add ios` on every build.
# Anchored with a leading slash so the patterns only match top-level dirs;
# `assets/ios/AppIcon.appiconset` and `assets/android/mipmap-*` (icon
# source-of-truth, copied into the generated platform tree at build time)
# are intentionally tracked.
/ios/
/android/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code — share team-level config; ignore per-developer overrides
.claude/settings.local.json
CLAUDE.local.md
*.local.md

# Supabase CLI local cache (per-developer)
supabase/.temp/
supabase/.branches/
