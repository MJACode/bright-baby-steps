{
  "expo": {
    "name": "Grace Flare",
    "slug": "grace-flare-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "graceflare",
    "ios": {
      "bundleIdentifier": "com.graceflare.mobile",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
