// Copy this file to Config.xcconfig and fill in the values.
// Config.xcconfig is gitignored.
//
// Values come from src/integrations/supabase/client.ts in the web app —
// the anon key is already public there, but we still keep it out of Git
// so iOS deployments can rotate or point to a staging project without a
// code change.

// xcconfig requires // to be escaped inside string values. Replace the
// escaped form below with a real URL like https$()://abc123.supabase.co
SUPABASE_URL = REPLACE_WITH_SUPABASE_URL
SUPABASE_ANON_KEY = REPLACE_WITH_SUPABASE_ANON_KEY
