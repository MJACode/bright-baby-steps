{
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "https://ieuznbvvwdvhtirzwkly.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "https://ieuznbvvwdvhtirzwkly.supabase.co/functions/v1/mcp/.well-known/oauth-authorization-server" },
    { "source": "/mcp", "destination": "https://ieuznbvvwdvhtirzwkly.supabase.co/functions/v1/mcp/mcp" },
    { "source": "/oauth/:path*", "destination": "https://ieuznbvvwdvhtirzwkly.supabase.co/functions/v1/mcp/oauth/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=()" }
      ]
    }
  ]
}
