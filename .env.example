# Copy this file to .env and fill in the values for your Supabase project.
# These are the public client-side keys (anon key is publishable by design).

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Optional: set to your production URL once published (e.g. https://graceflare.app).
# Falls back to window.location.origin when empty.
# VITE_APP_URL=""
